{
  "info": {
    "name": "Rehearsal Booking API",
    "description": "Requests for the rehearsal room booking REST API. Run the whole collection with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Rooms",
      "item": [
        {
          "name": "1. Create room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{roomName}}\",\n  \"capacity\": 5,\n  \"hourlyPrice\": 15.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A unique name, so that the collection can be run many times",
                  "const roomName = \"Studija \" + Date.now();",
                  "pm.collectionVariables.set(\"roomName\", roomName);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has a Location header\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "",
                  "const room = pm.response.json();",
                  "pm.collectionVariables.set(\"roomId\", room.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get all rooms (ETag and Cache-Control)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has an ETag header\", function () {",
                  "    pm.response.to.have.header(\"ETag\");",
                  "});",
                  "",
                  "pm.test(\"Cache-Control is no-cache\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.equal(\"no-cache\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Create room with the same name (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{roomName}}\",\n  \"capacity\": 8,\n  \"hourlyPrice\": 20.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Message says the name is in use\", function () {",
                  "    const error = pm.response.json();",
                  "    pm.expect(error.message).to.include(\"Room name is already in use\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Create room with capacity 0 (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Studija B\",\n  \"capacity\": 0,\n  \"hourlyPrice\": 15.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Message explains the capacity rule\", function () {",
                  "    const error = pm.response.json();",
                  "    pm.expect(error.message).to.include(\"Capacity must be at least 1\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Get room that does not exist (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms",
                "99999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error has the common format\", function () {",
                  "    const error = pm.response.json();",
                  "    pm.expect(error.status).to.equal(404);",
                  "    pm.expect(error.path).to.equal(\"/rooms/99999\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bands",
      "item": [
        {
          "name": "6. Create band",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bands"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vakaro Aidas\",\n  \"contactEmail\": \"aidas@example.com\",\n  \"membersCount\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const band = pm.response.json();",
                  "pm.collectionVariables.set(\"bandId\", band.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "7. Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bandId\": {{bandId}},\n  \"roomId\": {{roomId}},\n  \"startTime\": \"{{bookingDay}}T18:00:00\",\n  \"endTime\": \"{{bookingDay}}T20:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The booking day is always 3 days from today",
                  "const day = new Date();",
                  "day.setDate(day.getDate() + 3);",
                  "const bookingDay = day.toISOString().substring(0, 10);",
                  "pm.collectionVariables.set(\"bookingDay\", bookingDay);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const booking = pm.response.json();",
                  "pm.collectionVariables.set(\"bookingId\", booking.id);",
                  "",
                  "pm.test(\"Booking is active and costs 30.00\", function () {",
                  "    pm.expect(booking.status).to.equal(\"ACTIVE\");",
                  "    pm.expect(booking.price).to.equal(30);",
                  "});",
                  "",
                  "pm.test(\"Active booking has a cancel link\", function () {",
                  "    pm.expect(booking._links.cancel).to.not.equal(undefined);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Create overlapping booking (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bandId\": {{bandId}},\n  \"roomId\": {{roomId}},\n  \"startTime\": \"{{bookingDay}}T19:00:00\",\n  \"endTime\": \"{{bookingDay}}T21:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Message says the room is booked\", function () {",
                  "    const error = pm.response.json();",
                  "    pm.expect(error.message).to.include(\"Room is already booked at this time\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Get room bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/{{roomId}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms",
                "{{roomId}}",
                "bookings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Room has one active booking\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body._embedded.bookings.length).to.equal(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Cancel booking",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const booking = pm.response.json();",
                  "",
                  "pm.test(\"Booking is cancelled\", function () {",
                  "    pm.expect(booking.status).to.equal(\"CANCELLED\");",
                  "});",
                  "",
                  "pm.test(\"Cancelled booking has no cancel link\", function () {",
                  "    pm.expect(booking._links.cancel).to.equal(undefined);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Cancel the same booking again (409)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Message says the booking is already cancelled\", function () {",
                  "    const error = pm.response.json();",
                  "    pm.expect(error.message).to.equal(\"Booking is already cancelled\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "roomName",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "bandId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "bookingDay",
      "value": ""
    }
  ]
}